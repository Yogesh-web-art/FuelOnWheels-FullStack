<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FuelOnWheelsApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Window & text colors -->
        <item name="android:windowBackground">@color/bg_slate</item>
        <item name="android:textColorPrimary">@color/brand_navy</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_slate</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- High-End Luxury Splash Screen Theme -->
    <style name="Theme.FuelOnWheelsApp.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#090E1B</item>
        <item name="android:statusBarColor">#0D1629</item>
        <item name="android:navigationBarColor">#04060C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
