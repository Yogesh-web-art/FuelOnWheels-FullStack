<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_order_sheet"
    android:elevation="16dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    tools:context=".dashboard.OrderFragment">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/card_elevated_rounded"
        android:backgroundTint="#CBD5E1" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Fuel"
                android:textColor="@color/brand_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time doorstep fuel dispenser"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_pill_blue"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="15-20 mins"
            android:textColor="@color/pill_blue_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- PETROL CARD -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Fuel Icon Badge -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/badge_pill_amber"
                android:padding="10dp"
                android:contentDescription="Petrol"
                android:src="@drawable/ic_baseline_local_gas_station_24"
                app:tint="@color/pill_amber_text" />

            <!-- Title & Price Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Petrol (Regular)"
                    android:textColor="@color/brand_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹100 / Litre"
                    android:textColor="@color/pill_amber_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Petrol Stepper & Add Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/petrol_minus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_stepper_action"
                    app:backgroundTint="@null"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="−"
                    android:textColor="@color/brand_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/petrol_quant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="38dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/x1"
                    android:textColor="@color/brand_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/petrol_plus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_stepper_action"
                    app:backgroundTint="@null"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="@color/brand_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/petrol_add"
                    android:layout_width="78dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_add_fuel"
                    app:backgroundTint="@null"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="+ ADD"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- DIESEL CARD -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Fuel Icon Badge -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/badge_pill_green"
                android:padding="10dp"
                android:contentDescription="Diesel"
                android:src="@drawable/ic_baseline_local_gas_station_24"
                app:tint="@color/pill_green_text" />

            <!-- Title & Price Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diesel (Hi-Speed)"
                    android:textColor="@color/brand_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹94 / Litre"
                    android:textColor="@color/pill_green_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Diesel Stepper & Add Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/diesel_minus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_stepper_action"
                    app:backgroundTint="@null"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="−"
                    android:textColor="@color/brand_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/diesel_quant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="38dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/x1"
                    android:textColor="@color/brand_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/diesel_plus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_stepper_action"
                    app:backgroundTint="@null"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="@color/brand_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/diesel_add"
                    android:layout_width="78dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_add_fuel"
                    app:backgroundTint="@null"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="+ ADD"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Trust Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Calibrated digital dispensers • 100% quality assured"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

</LinearLayout>
