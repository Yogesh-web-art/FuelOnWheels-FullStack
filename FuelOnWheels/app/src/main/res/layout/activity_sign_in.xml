<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".splashScreen.MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/signIn_header_and_inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="@drawable/blue_bg">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="50dp"
                        android:src="@drawable/logo"
                        android:contentDescription="@string/logo" />

                </FrameLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginRight="45dp"
                    android:background="@drawable/blue_border_rounded_cornwe">

                    <EditText
                        android:id="@+id/signIn_et_phone_no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/phone_num_icon"
                        android:background="@android:color/transparent"
                        android:hint="@string/Mobile_Number"
                        android:inputType="phone"
                        android:maxLength="14"
                        android:paddingStart="17dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:textColor="@color/black"
                        android:textCursorDrawable="@drawable/cursor_color"
                        android:textSize="14sp"
                        tools:ignore="RtlSymmetry,TouchTargetSizeCheck"
                        android:autofillHints="phone" />

                    <ImageView
                        android:id="@+id/phone_num_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/phonenum"
                        android:contentDescription="@string/enter_phone_number" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="45dp"
                    android:background="@drawable/blue_border_rounded_cornwe">

                    <EditText
                        android:id="@+id/signIn_et_otp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/icon"
                        android:background="@android:color/transparent"
                        android:hint="@string/OTP"
                        android:inputType="number"
                        android:maxLength="6"
                        android:paddingStart="17dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:textColor="@android:color/background_dark"
                        android:textCursorDrawable="@drawable/cursor_color"
                        android:textSize="14sp"
                        tools:ignore="RtlSymmetry,TouchTargetSizeCheck"
                        android:autofillHints="otp" />

                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/password"
                        android:contentDescription="@string/password" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/signIn_btn_getOtp"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/blue_fill__rounded_color"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/get_otp"
                        android:textColor="#ffffff"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/signIn_btn_next"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/blue_fill__rounded_color"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/next"
                        android:textColor="#ffffff"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/signIn_tv_resend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:minHeight="40dp"
                    android:text="@string/didn_t_get_an_otp_resend"
                    android:textColor="#1566e0"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/signIn_header_and_inputs"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="25dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="— OR CHOOSE ANOTHER LOGIN METHOD —"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp"
                    android:letterSpacing="0.05" />

                <Button
                    android:id="@+id/signIn_btn_email_login"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/blue_fill__rounded_color"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Sign In / Register with Email"
                    android:textColor="#ffffff"
                    android:textSize="12sp" />

            </LinearLayout>

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>
