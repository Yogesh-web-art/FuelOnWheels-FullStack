<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for FuelOnWheels -->
    <style name="Theme.FuelOnWheelsApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Window & text colors -->
        <item name="android:windowBackground">@color/bg_slate</item>
        <item name="android:textColorPrimary">@color/brand_navy</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_slate</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
